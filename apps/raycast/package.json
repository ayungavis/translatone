{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "translatone",
  "description": "Translate text with the right tone for LinkedIn, email, and chat using free AI providers.",
  "categories": [
    "Communication",
    "Productivity"
  ],
  "license": "MIT",
  "author": "ayungavis",
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^2.10.1",
    "@raycast/utils": "^2.3.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/bun": "^1.4.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "icon": "icon.png",
  "commands": [
    {
      "name": "translate",
      "title": "Translate",
      "subtitle": "TranslaTone",
      "description": "Translate text with a selected tone and target language.",
      "mode": "view"
    },
    {
      "name": "translate-selection",
      "title": "Translate Selection",
      "subtitle": "TranslaTone",
      "description": "Translate the selected text using your default tone and target language.",
      "mode": "view"
    }
  ],
  "platforms": [
    "macOS"
  ],
  "preferences": [
    {
      "name": "groqApiKey",
      "title": "Groq API Key",
      "description": "Free key from console.groq.com. Tried first.",
      "type": "password",
      "required": false
    },
    {
      "name": "groqModel",
      "title": "Groq Model",
      "description": "Model used for Groq requests.",
      "type": "textfield",
      "required": false,
      "default": "llama-3.1-8b-instant"
    },
    {
      "name": "geminiApiKey",
      "title": "Gemini API Key",
      "description": "Free key from aistudio.google.com. Used when Groq is unavailable.",
      "type": "password",
      "required": false
    },
    {
      "name": "geminiModel",
      "title": "Gemini Model",
      "description": "Model used for Gemini requests.",
      "type": "textfield",
      "required": false,
      "default": "gemini-2.5-flash"
    },
    {
      "name": "useOllama",
      "title": "Local Fallback",
      "label": "Use Ollama when cloud providers are unavailable",
      "description": "Requires Ollama running locally.",
      "type": "checkbox",
      "required": false,
      "default": false
    },
    {
      "name": "ollamaModel",
      "title": "Ollama Model",
      "description": "Model used for Ollama requests.",
      "type": "textfield",
      "required": false,
      "default": "llama3.1"
    },
    {
      "name": "ollamaBaseUrl",
      "title": "Ollama URL",
      "description": "OpenAI-compatible Ollama endpoint.",
      "type": "textfield",
      "required": false,
      "default": "http://localhost:11434/v1"
    },
    {
      "name": "defaultTargetLanguage",
      "title": "Default Target Language",
      "description": "Language used by Translate Selection and as the initial choice in Translate.",
      "type": "dropdown",
      "required": false,
      "default": "en",
      "data": [
        {
          "title": "English",
          "value": "en"
        },
        {
          "title": "Indonesian",
          "value": "id"
        },
        {
          "title": "Malay",
          "value": "ms"
        },
        {
          "title": "Chinese (Simplified)",
          "value": "zh-Hans"
        },
        {
          "title": "Chinese (Traditional)",
          "value": "zh-Hant"
        },
        {
          "title": "Japanese",
          "value": "ja"
        },
        {
          "title": "Korean",
          "value": "ko"
        },
        {
          "title": "Thai",
          "value": "th"
        },
        {
          "title": "Vietnamese",
          "value": "vi"
        },
        {
          "title": "Hindi",
          "value": "hi"
        },
        {
          "title": "Arabic",
          "value": "ar"
        },
        {
          "title": "Spanish",
          "value": "es"
        },
        {
          "title": "Portuguese",
          "value": "pt"
        },
        {
          "title": "French",
          "value": "fr"
        },
        {
          "title": "German",
          "value": "de"
        },
        {
          "title": "Italian",
          "value": "it"
        },
        {
          "title": "Dutch",
          "value": "nl"
        },
        {
          "title": "Russian",
          "value": "ru"
        },
        {
          "title": "Turkish",
          "value": "tr"
        }
      ]
    },
    {
      "name": "defaultTone",
      "title": "Default Tone",
      "description": "Tone used by Translate Selection and as the initial choice in Translate.",
      "type": "dropdown",
      "required": false,
      "default": "default",
      "data": [
        {
          "title": "Default",
          "value": "default"
        },
        {
          "title": "LinkedIn",
          "value": "linkedin"
        },
        {
          "title": "Email",
          "value": "email"
        },
        {
          "title": "Chat",
          "value": "chat"
        }
      ]
    }
  ],
  "title": "TranslaTone"
}
